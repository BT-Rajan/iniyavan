APP_NAME="Zigora"
# MariaDB. URL-encode special characters in the password (# becomes %23)
DATABASE_URL=mysql+pymysql://app_user:PASSWORD@localhost/engtutor?charset=utf8mb4
# Required, 32+ random characters (the app refuses to start without it). run.sh generates one if it is missing.
JWT_SECRET=generate-with-openssl-rand-hex-32
HOST=169.58.13.213
PORT=5252
# Where uploaded content images are stored (back this folder up). Defaults to backend/uploads
# UPLOAD_DIR=/var/lib/eng-tutor/uploads
# Optional: days a sign-in lasts (default 7), and password hashing rounds (default 600000)
# TOKEN_DAYS=7
# PBKDF2_ITER=600000
# Optional: only if the front-end is served from a different origin, comma separated
# ALLOWED_ORIGINS=https://learn.example.edu
# Optional: where backup.sh writes backups (default ./backups) and how long old ones are kept is set with --keep-days
# BACKUP_DIR=/var/backups/eng-tutor
# Optional: forgot-password by email. Also required for self-registration (the verification code is emailed). All three of SMTP_HOST, SMTP_FROM and APP_URL are needed; without them the login page tells people to ask an admin.
# APP_URL is the public address people use (links in emails point there, never at the Host header).
# SMTP_HOST=smtp.example.edu
# SMTP_PORT=587
# SMTP_TLS=starttls        # starttls (587), ssl (465) or none
# SMTP_USER=noreply@example.edu
# SMTP_PASSWORD=
# SMTP_FROM="Zigora <noreply@example.edu>"
# APP_URL=https://learn.example.edu
# RESET_MINUTES=30
# Optional: the local hour after which the daily notification summary emails go out (people switch them on in the bell). Default 7.
# DIGEST_HOUR=7

# Optional: AI searches each student may run per day (answers already saved do not count). Default 30.
# AI_SEARCH_DAILY=30

# Optional: minutes ahead of UTC at which a student's study day starts (for streaks). 330 = India (default), 0 = UTC.
# DAY_OFFSET_MINUTES=330
# Scanned PDFs are read with Tesseract (sudo apt install tesseract-ocr). Languages joined with +, each needs its pack
# (tesseract-ocr-tam, tesseract-ocr-hin, ...). Pages are read in the background, OCR_WORKERS files at a time.
# Optional: the site under a folder of its address, e.g. https://apps.perennia.org/zigora: BASE_PATH=/zigora, and APP_URL with the folder
# (APP_URL=https://apps.perennia.org/zigora). The reverse proxy passes /zigora/ through unchanged (see README, "Under a folder of the address").
# BASE_PATH=/zigora
# Optional: Sign in with Google. The Web client ID from Google Cloud (see docs/google-sign-in.md); an admin can also set it in Settings.
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# OCR_LANGS=eng
# OCR_WORKERS=1
# OCR_MAX_PAGES=300
